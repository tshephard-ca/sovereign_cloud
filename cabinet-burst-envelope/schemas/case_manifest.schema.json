{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cabinet-burst-envelope/case_manifest.schema.json",
  "title": "Cabinet Case Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "cabinet_id",
    "case_goal",
    "business_scenario",
    "expected_review_lane",
    "review_owner",
    "remediation_owner",
    "do_not_claim"
  ],
  "properties": {
    "schema_version": {"const": "cabinet-burst-envelope.case_manifest.v1"},
    "cabinet_id": {"type": "string"},
    "case_goal": {"type": "string"},
    "business_scenario": {"type": "string"},
    "expected_review_lane": {"enum": ["READY_FOR_FACILITY_REVIEW", "NEEDS_REMEDIATION", "STOP_EXPANSION_DISCUSSION", "COLLECT_EVIDENCE"]},
    "review_owner": {"type": "string"},
    "remediation_owner": {"type": "string"},
    "do_not_claim": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
