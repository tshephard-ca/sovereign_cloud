{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cabinet-burst-envelope/summary.schema.json",
  "title": "Cabinet Burst Envelope Summary",
  "type": "object",
  "required": [
    "schema_version",
    "tool_version",
    "cabinet_id",
    "envelope_status",
    "confidence",
    "input",
    "review_lane",
    "recommendation",
    "risk",
    "reason_code_counts",
    "warnings",
    "blockers",
    "action_queue",
    "recommended_next_questions"
  ],
  "properties": {
    "schema_version": {"const": "cabinet-burst-envelope.summary.v1"},
    "tool_version": {"type": "string"},
    "cabinet_id": {"type": "string"},
    "envelope_status": {"enum": ["READY_FOR_REVIEW", "REVIEW_REQUIRED", "DO_NOT_EXPAND", "INSUFFICIENT_DATA"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "input": {"type": "object"},
    "review_lane": {"type": "object"},
    "recommendation": {"type": "object"},
    "risk": {"type": "object"},
    "reason_code_counts": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "action_queue": {"type": "array", "items": {"type": "object"}},
    "recommended_next_questions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
