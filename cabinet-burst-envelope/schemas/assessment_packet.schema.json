{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cabinet-burst-envelope/assessment_packet.schema.json",
  "title": "Cabinet Assessment Packet Manifest",
  "type": "object",
  "required": ["schema_version", "tool_version", "generated_at", "cabinet_id", "bundle_type", "files", "input_fingerprints"],
  "properties": {
    "schema_version": {"const": "cabinet-burst-envelope.manifest.v1"},
    "tool_version": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "cabinet_id": {"type": "string"},
    "bundle_type": {"enum": ["assessment_packet", "redacted_assessment_packet"]},
    "files": {"type": "object"},
    "input_fingerprints": {"type": "object"}
  },
  "additionalProperties": true
}
